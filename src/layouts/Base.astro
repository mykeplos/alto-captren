---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import IconoMarca from '../components/IconoMarca.astro';
import { enlaceWhatsApp, WHATSAPP_VISIBLE } from '../config';
import { otherLang, useTranslations, type Lang } from '../i18n/ui';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta de esta página sin el idioma, ej. '' o 'cabanas/'. Sirve para el botón ES / EN. */
  path?: string;
}

const { lang, title, description, path = '' } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} · ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');
const home = url(`${lang}/`);
const year = new Date().getFullYear();

const navItems: { label: string; href: string }[] = [
  { label: t('nav.home'), href: home },
  { label: t('nav.cabins'), href: url(`${lang}/cabanas/`) },
  { label: t('nav.location'), href: url(`${lang}/ubicacion/`) },
  { label: t('nav.activities'), href: url(`${lang}/actividades/`) },
  { label: t('nav.faq'), href: url(`${lang}/preguntas/`) },
  { label: t('nav.contact'), href: '#contacto' },
];
const current = Astro.url.pathname;
const reservar = url(`${lang}/reservar/`);
const waHola = enlaceWhatsApp(t('wa.hola'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="alternate" hreflang={lang} href={new URL(url(`${lang}/${path}`), Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(url(`${other}/${path}`), Astro.site)} />
    <meta name="theme-color" content="#1f3a2e" />
    <!-- Marca que hay JavaScript: solo así se esconden los bloques que aparecen al hacer scroll -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={home}>
          <img src={url('favicon.svg')} alt="" width="32" height="32" />
          <span>{t('site.name')}</span>
        </a>
        <a class="btn btn-header" href={reservar} aria-current={reservar === current ? 'page' : undefined}>
          {t('nav.book')}
        </a>
        <a class="lang-switch" href={url(`${other}/${path}`)} hreflang={other} lang={other}>
          {other.toUpperCase()}
          <span class="sr-only">{t('lang.switch')}</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
          <Icon name="menu" size={26} />
          <span class="sr-only">{t('nav.menu')}</span>
        </button>
        <nav id="menu-principal" class="nav" aria-label={t('nav.menu')}>
          <ul class="nav-list">
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="solo-movil">
              <a class="nav-reservar" href={reservar}>{t('nav.book')}</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <script is:inline>
      (function () {
        var boton = document.querySelector('.menu-toggle');
        var menu = document.getElementById('menu-principal');
        if (!boton || !menu) return;
        function cerrar() {
          boton.setAttribute('aria-expanded', 'false');
          menu.classList.remove('abierto');
        }
        boton.addEventListener('click', function () {
          var abierto = boton.getAttribute('aria-expanded') === 'true';
          boton.setAttribute('aria-expanded', String(!abierto));
          menu.classList.toggle('abierto', !abierto);
        });
        menu.addEventListener('click', function (e) {
          if (e.target.closest('a')) cerrar();
        });
      })();
    </script>

    <main>
      <slot />
    </main>

    <footer class="site-footer" id="contacto">
      <div class="container">
        <p class="footer-name">{t('site.name')}</p>
        <p>{t('footer.location')}</p>
        <p>
          <a class="footer-wa" href={waHola} target="_blank" rel="noopener">
            <IconoMarca name="whatsapp" size={18} />
            {WHATSAPP_VISIBLE}
          </a>
        </p>
        <p class="footer-small">© {year} {t('site.name')}. {t('footer.rights')}</p>
      </div>
    </footer>

    <a class="wa-flotante" href={waHola} target="_blank" rel="noopener" aria-label={t('wa.flotante')}>
      <IconoMarca name="whatsapp" size={30} />
      <span class="wa-texto">{t('wa.flotante')}</span>
    </a>
    <script is:inline>
      // Efectos: bloques que aparecen al hacer scroll y sombra del encabezado
      (function () {
        var grupos = document.querySelectorAll('[data-revelar-grupo]');
        grupos.forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (hijo, i) {
            hijo.setAttribute('data-revelar', '');
            hijo.style.setProperty('--i', String(Math.min(i, 6)));
          });
        });
        var bloques = document.querySelectorAll('[data-revelar]');
        if (!('IntersectionObserver' in window)) {
          bloques.forEach(function (b) { b.classList.add('visible'); });
        } else {
          var obs = new IntersectionObserver(
            function (entradas) {
              entradas.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('visible');
                  obs.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );
          bloques.forEach(function (b) { obs.observe(b); });
        }
        var header = document.querySelector('.site-header');
        function sombra() {
          if (header) header.classList.toggle('con-sombra', window.scrollY > 8);
        }
        sombra();
        window.addEventListener('scroll', sombra, { passive: true });
      })();
    </script>
  </body>
</html>
