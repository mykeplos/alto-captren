---
// Calendario de disponibilidad: lee los días ocupados de Google Calendar (un calendario por cabaña).
// Solo pide a Google las fechas de inicio y fin de cada evento, nunca el título ni los detalles.
import { cabanas } from '../data/cabanas';
import type { Lang } from '../i18n/ui';
import { enlaceWhatsApp } from '../config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const clave = import.meta.env.PUBLIC_GOOGLE_API_KEY ?? '';
const calendarios: Record<string, string> = {
  'cabana-1': import.meta.env.PUBLIC_CAL_CABANA_1 ?? '',
  'cabana-2': import.meta.env.PUBLIC_CAL_CABANA_2 ?? '',
};
const configurado = Boolean(clave && calendarios['cabana-1'] && calendarios['cabana-2']);
// En la PC (npm run dev) sin configurar, muestra días ocupados de ejemplo para poder probar.
const demo = !configurado && import.meta.env.DEV;
// Publicado sin Google Calendar: igual se eligen fechas, y la disponibilidad se confirma por WhatsApp.
const sinDatos = !configurado && !demo;

const t = {
  es: {
    titulo: 'Disponibilidad',
    tituloFechas: 'Elige tus fechas',
    ayuda: 'Toca tu día de llegada y después tu día de salida.',
    libre: 'Disponible',
    ocupado: 'Ocupado',
    elegido: 'Tu estadía',
    anterior: 'Mes anterior',
    siguiente: 'Mes siguiente',
    cargando: 'Cargando disponibilidad…',
    error: 'No pudimos cargar los días ocupados. Elige tus fechas igual y te confirmamos la disponibilidad por WhatsApp.',
    sinCalendario: 'El calendario de disponibilidad estará disponible muy pronto. Mientras tanto, consúltanos las fechas por WhatsApp.',
    consultar: 'Consultar fechas por WhatsApp',
    choque: 'Esas fechas incluyen noches ocupadas. Elige otra salida.',
    demo: 'Modo de prueba: días ocupados de ejemplo.',
    sinDatos: 'Elige tus fechas y te confirmamos la disponibilidad por WhatsApp.',
    eligeSalida: 'ahora elige tu día de salida',
    noche: 'noche',
    nochesPl: 'noches',
    borrar: 'Borrar fechas',
    minimo: 'En temporada alta la estadía mínima es de 2 noches.',
    dias: ['L', 'M', 'M', 'J', 'V', 'S', 'D'],
  },
  en: {
    titulo: 'Availability',
    tituloFechas: 'Choose your dates',
    ayuda: 'Tap your check-in day and then your check-out day.',
    libre: 'Available',
    ocupado: 'Booked',
    elegido: 'Your stay',
    anterior: 'Previous month',
    siguiente: 'Next month',
    cargando: 'Loading availability…',
    error: 'We could not load the booked days. Choose your dates anyway and we will confirm availability on WhatsApp.',
    sinCalendario: 'The availability calendar is coming soon. Meanwhile, ask us about your dates on WhatsApp.',
    consultar: 'Ask about dates on WhatsApp',
    choque: 'Those dates include booked nights. Choose another check-out.',
    demo: 'Test mode: sample booked days.',
    sinDatos: 'Choose your dates and we will confirm availability on WhatsApp.',
    eligeSalida: 'now choose your check-out day',
    noche: 'night',
    nochesPl: 'nights',
    borrar: 'Clear dates',
    minimo: 'In high season the minimum stay is 2 nights.',
    dias: ['M', 'T', 'W', 'T', 'F', 'S', 'S'],
  },
}[lang];

const pestanas = cabanas.map((c) => ({ id: c.id, nombre: c.nombre[lang] }));
const waConsulta = enlaceWhatsApp(
  lang === 'es' ? 'Hola, quiero consultar disponibilidad en Cabañas Alto Captren.' : 'Hi, I would like to check availability at Alto Captren Cabins.',
);
---

<section class="calendario" id="disponibilidad" aria-labelledby="cal-titulo">
  <div class="cal-cabecera">
    <h2 id="cal-titulo">{sinDatos ? t.tituloFechas : t.titulo}</h2>
    <div class="cal-pestanas" role="tablist">
      {
        pestanas.map((p, i) => (
          <button type="button" role="tab" class="cal-pestana" data-cabana={p.id} aria-selected={i === 0 ? 'true' : 'false'}>
            {p.nombre}
          </button>
        ))
      }
    </div>
  </div>

  <p class="cal-ayuda">{t.ayuda}</p>
  {demo && <p class="cal-demo">{t.demo}</p>}
  {
    sinDatos && (
      <p class="cal-demo">
        {t.sinDatos}{' '}
        <a href={waConsulta} target="_blank" rel="noopener">
          {t.consultar}
        </a>
      </p>
    )
  }
  <p class="cal-demo" data-error-carga hidden>{t.error}</p>
  <div class="cal-nav">
    <div class="cal-seleccion" data-seleccion>
      <span data-sel-texto></span>
      <button type="button" class="cal-borrar" data-borrar hidden>
        <Icon name="x" size={14} />
        {t.borrar}
      </button>
    </div>
    <button type="button" class="cal-flecha" data-mover="-1" aria-label={t.anterior}>
      <Icon name="chevron-left" size={20} />
    </button>
    <button type="button" class="cal-flecha" data-mover="1" aria-label={t.siguiente}>
      <Icon name="chevron-right" size={20} />
    </button>
  </div>
  <div class="cal-meses" data-meses aria-live="polite">
    <p class="cal-estado">{t.cargando}</p>
  </div>
  <p class="cal-aviso" data-aviso role="alert" hidden></p>
  <ul class="cal-leyenda">
    <li><span class="punto libre"></span> {t.libre}</li>
    {!sinDatos && <li><span class="punto ocupado"></span> {t.ocupado}</li>}
    <li><span class="punto elegido"></span> {t.elegido}</li>
  </ul>
</section>

{
  (
    <script is:inline define:vars={{ clave, calendarios, demo, sinDatos, t, lang }}>
      // Espera a que exista el formulario de reserva (está más abajo en la página)
      document.addEventListener('DOMContentLoaded', function () {
        var raiz = document.getElementById('disponibilidad');
        if (!raiz) return;
        var contenedor = raiz.querySelector('[data-meses]');
        var aviso = raiz.querySelector('[data-aviso]');
        var locale = lang === 'es' ? 'es-CL' : 'en-US';
        var ZONA = 'America/Santiago';
        var MESES_VISIBLES = window.matchMedia('(min-width: 760px)').matches ? 2 : 1;

        // Fecha "YYYY-MM-DD" según la hora de Chile
        var fmtChile = new Intl.DateTimeFormat('en-CA', { timeZone: ZONA, year: 'numeric', month: '2-digit', day: '2-digit' });
        var fmtHora = new Intl.DateTimeFormat('en-GB', { timeZone: ZONA, hour: '2-digit', hourCycle: 'h23' });
        function claveChile(d) {
          return fmtChile.format(d);
        }
        function aISO(y, m, d) {
          return y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
        }
        function sumarDias(iso, n) {
          var p = iso.split('-').map(Number);
          var d = new Date(Date.UTC(p[0], p[1] - 1, p[2] + n));
          return d.toISOString().slice(0, 10);
        }

        var hoy = claveChile(new Date());
        var ocupados = {}; // { 'cabana-1': Set de noches 'YYYY-MM-DD' }
        Object.keys(calendarios).forEach(function (id) { ocupados[id] = new Set(); });
        window.altoCaptrenOcupado = ocupados;

        var cabana = Object.keys(calendarios)[0];
        var hoyP = hoy.split('-').map(Number);
        var mes = { y: hoyP[0], m: hoyP[1] - 1 };
        var cargado = false;

        // Una noche X está ocupada si el evento cubre las 23:00 de X (hora de Chile)
        function marcar(id, inicio, fin) {
          var s = new Date(inicio).getTime();
          var e = new Date(fin).getTime();
          for (var tms = s; tms < e; tms += 3600000) {
            var d = new Date(tms);
            if (fmtHora.format(d) === '23') ocupados[id].add(claveChile(d));
          }
        }

        function datosDemo() {
          ['cabana-1', 'cabana-2'].forEach(function (id, k) {
            [5, 6, 7, 18, 19, 33, 34, 35, 36].forEach(function (n) {
              ocupados[id].add(sumarDias(hoy, n + k * 3));
            });
          });
        }

        function cargar() {
          if (demo) {
            datosDemo();
            return Promise.resolve();
          }
          if (sinDatos) return Promise.resolve();
          var desde = new Date();
          desde.setDate(desde.getDate() - 1);
          var hasta = new Date();
          hasta.setMonth(hasta.getMonth() + 13);
          return Promise.all(
            Object.keys(calendarios).map(function (id) {
              var url =
                'https://www.googleapis.com/calendar/v3/calendars/' +
                encodeURIComponent(calendarios[id]) +
                '/events?singleEvents=true&orderBy=startTime&maxResults=2500' +
                '&timeMin=' + encodeURIComponent(desde.toISOString()) +
                '&timeMax=' + encodeURIComponent(hasta.toISOString()) +
                '&fields=' + encodeURIComponent('items(start,end,transparency)') +
                '&key=' + encodeURIComponent(clave);
              return fetch(url)
                .then(function (r) {
                  if (!r.ok) throw new Error('HTTP ' + r.status);
                  return r.json();
                })
                .then(function (data) {
                  (data.items || []).forEach(function (ev) {
                    if (ev.transparency === 'transparent') return; // eventos marcados "Disponible"
                    var ini = ev.start.dateTime || ev.start.date + 'T00:00:00-03:00';
                    var fin = ev.end.dateTime || ev.end.date + 'T00:00:00-03:00';
                    if (!ev.start.dateTime) {
                      // Evento de día completo: ocupa las noches desde start.date hasta el día antes de end.date
                      for (var iso = ev.start.date; iso < ev.end.date; iso = sumarDias(iso, 1)) ocupados[id].add(iso);
                      return;
                    }
                    marcar(id, ini, fin);
                  });
                });
            })
          );
        }

        // --- Conexión con el formulario de reserva ---
        var form = document.getElementById('form-reserva');
        function campo(n) {
          return form ? form.elements.namedItem(n) : null;
        }
        function setCampo(n, v) {
          var c = campo(n);
          if (!c) return;
          c.value = v;
          c.dispatchEvent(new Event('input', { bubbles: true }));
          c.dispatchEvent(new Event('change', { bubbles: true }));
        }
        function seleccion() {
          return { lleg: (campo('llegada') || {}).value || '', sal: (campo('salida') || {}).value || '' };
        }
        function hayChoque(lleg, sal) {
          for (var iso = lleg; iso < sal; iso = sumarDias(iso, 1)) if (ocupados[cabana].has(iso)) return true;
          return false;
        }

        function esAlta(iso) {
          var m = Number(iso.slice(5, 7));
          return m === 12 || m === 1 || m === 2 || m === 7 || m === 8;
        }
        function necesitaMinimo(lleg, sal) {
          if (sumarDias(lleg, 1) !== sal) return false;
          return esAlta(lleg);
        }
        function bonita(iso) {
          var p = iso.split('-').map(Number);
          return new Date(p[0], p[1] - 1, p[2]).toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short' });
        }
        function contarNoches(a, b) {
          var n = 0;
          for (var iso = a; iso < b; iso = sumarDias(iso, 1)) n++;
          return n;
        }
        var selTexto = raiz.querySelector('[data-sel-texto]');
        var borrar = raiz.querySelector('[data-borrar]');
        function pintarSeleccion() {
          var s = seleccion();
          if (s.lleg && s.sal) {
            var n = contarNoches(s.lleg, s.sal);
            selTexto.innerHTML =
              '<strong>' + bonita(s.lleg) + '</strong> → <strong>' + bonita(s.sal) + '</strong> · ' + n + ' ' + (n === 1 ? t.noche : t.nochesPl);
          } else if (s.lleg) {
            selTexto.innerHTML = '<strong>' + bonita(s.lleg) + '</strong> → ' + t.eligeSalida;
          } else {
            selTexto.textContent = '';
          }
          borrar.hidden = !s.lleg;
        }

        function mostrarAviso(msg) {
          aviso.textContent = msg || '';
          aviso.hidden = !msg;
        }

        function elegir(iso) {
          mostrarAviso('');
          var s = seleccion();
          if (!s.lleg || s.sal || iso <= s.lleg) {
            if (ocupados[cabana].has(iso)) return;
            setCampo('llegada', iso);
            setCampo('salida', '');
          } else {
            if (hayChoque(s.lleg, iso)) {
              mostrarAviso(t.choque);
              return;
            }
            setCampo('salida', iso);
            if (necesitaMinimo(s.lleg, iso)) mostrarAviso(t.minimo);
            var destino = document.querySelector('.resumen');
            if (destino && window.matchMedia('(max-width: 859px)').matches) destino.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          pintar();
        }

        function pintar() {
          if (!cargado) return;
          pintarSeleccion();
          var s = seleccion();
          contenedor.innerHTML = '';
          for (var k = 0; k < MESES_VISIBLES; k++) {
            var y = mes.y, m = mes.m + k;
            if (m > 11) { m -= 12; y++; }
            var caja = document.createElement('div');
            caja.className = 'cal-mes';
            var titulo = new Date(y, m, 1).toLocaleDateString(locale, { month: 'long', year: 'numeric' });
            var html = '<h3>' + titulo.charAt(0).toUpperCase() + titulo.slice(1) + '</h3><div class="cal-grilla">';
            t.dias.forEach(function (d) { html += '<span class="cal-dia-nombre">' + d + '</span>'; });
            var primero = (new Date(y, m, 1).getDay() + 6) % 7; // lunes = 0
            for (var v = 0; v < primero; v++) html += '<span></span>';
            var total = new Date(y, m + 1, 0).getDate();
            for (var d = 1; d <= total; d++) {
              var iso = aISO(y, m, d);
              var clases = ['cal-dia'];
              var pasado = iso < hoy;
              var ocup = ocupados[cabana].has(iso);
              if (pasado) clases.push('pasado');
              if (ocup) clases.push('ocupado');
              if (iso === hoy) clases.push('hoy');
              if (s.lleg && iso === s.lleg) clases.push('inicio');
              if (s.sal && iso === s.sal) clases.push('fin');
              if (s.lleg && s.sal && iso > s.lleg && iso < s.sal) clases.push('rango');
              // Un día ocupado igual puede ser día de SALIDA (se sale en la mañana)
              var puedeSalir = s.lleg && !s.sal && iso > s.lleg && !hayChoque(s.lleg, iso);
              var deshabilitado = pasado || (ocup && !puedeSalir);
              html +=
                '<button type="button" class="' + clases.join(' ') + '" data-dia="' + iso + '"' +
                (deshabilitado ? ' disabled' : '') + ' aria-label="' +
                new Date(y, m, d).toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }) +
                (ocup ? ' – ' + t.ocupado : '') + '">' + d + '</button>';
            }
            html += '</div>';
            caja.innerHTML = html;
            contenedor.appendChild(caja);
          }
          var prev = raiz.querySelector('[data-mover="-1"]');
          prev.disabled = mes.y === hoyP[0] && mes.m === hoyP[1] - 1;
        }

        raiz.addEventListener('click', function (e) {
          if (e.target.closest('[data-borrar]')) {
            setCampo('llegada', '');
            setCampo('salida', '');
            mostrarAviso('');
            return pintar();
          }
          var dia = e.target.closest('[data-dia]');
          if (dia && !dia.disabled) return elegir(dia.getAttribute('data-dia'));
          var mover = e.target.closest('[data-mover]');
          if (mover && !mover.disabled) {
            mes.m += Number(mover.getAttribute('data-mover'));
            if (mes.m < 0) { mes.m = 11; mes.y--; }
            if (mes.m > 11) { mes.m = 0; mes.y++; }
            return pintar();
          }
          var tab = e.target.closest('[data-cabana]');
          if (tab) {
            cabana = tab.getAttribute('data-cabana');
            raiz.querySelectorAll('[data-cabana]').forEach(function (b) { b.setAttribute('aria-selected', String(b === tab)); });
            if (campo('cabana') && campo('cabana').value !== cabana) setCampo('cabana', cabana);
            mostrarAviso('');
            pintar();
          }
        });

        // Vista previa del rango al pasar el mouse, después de elegir la llegada
        contenedor.addEventListener('mouseover', function (e) {
          var dia = e.target.closest('[data-dia]');
          var s = seleccion();
          var hasta = dia && !dia.disabled && s.lleg && !s.sal ? dia.getAttribute('data-dia') : '';
          contenedor.querySelectorAll('[data-dia]').forEach(function (b) {
            var iso = b.getAttribute('data-dia');
            b.classList.toggle('previa', !!hasta && iso > s.lleg && iso <= hasta);
          });
        });
        contenedor.addEventListener('mouseleave', function () {
          contenedor.querySelectorAll('.previa').forEach(function (b) { b.classList.remove('previa'); });
        });

        if (form) {
          form.classList.add('con-calendario');
          form.addEventListener('change', function (e) {
            if (e.target.name === 'cabana' && e.target.value !== cabana) {
              cabana = e.target.value;
              raiz.querySelectorAll('[data-cabana]').forEach(function (b) {
                b.setAttribute('aria-selected', String(b.getAttribute('data-cabana') === cabana));
              });
            }
            pintar();
          });
          form.addEventListener('input', pintar);
          var inicial = campo('cabana') && campo('cabana').value;
          if (inicial && ocupados[inicial]) {
            cabana = inicial;
            raiz.querySelectorAll('[data-cabana]').forEach(function (b) {
              b.setAttribute('aria-selected', String(b.getAttribute('data-cabana') === cabana));
            });
          }
          var s0 = seleccion();
          if (s0.lleg) {
            var p0 = s0.lleg.split('-').map(Number);
            mes = { y: p0[0], m: p0[1] - 1 };
          }
        }

        cargar()
          .then(function () {
            cargado = true;
            pintar();
          })
          .catch(function () {
            // Si Google falla, igual se pueden elegir fechas (sin días ocupados)
            Object.keys(ocupados).forEach(function (id) { ocupados[id].clear(); });
            raiz.querySelector('[data-error-carga]').hidden = false;
            cargado = true;
            pintar();
          });
      });
    </script>
  )
}

<style>
  .calendario {
    padding: 1.6rem;
    margin-bottom: 1.5rem;
    background: var(--superficie);
    border-radius: 24px;
    box-shadow: var(--sombra);
  }

  .cal-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .cal-cabecera h2 {
    margin: 0;
    font-size: 1.6rem;
  }

  .cal-pestanas {
    display: flex;
    gap: 0.3rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--chip);
  }

  .cal-pestana {
    padding: 0.45rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--texto-suave);
    font: inherit;
    font-family: var(--fuente-ui);
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cal-pestana[aria-selected='true'] {
    background: var(--superficie);
    color: var(--titulo);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
  }

  .cal-ayuda,
  .cal-demo {
    margin: 0.8rem 0 0;
    color: var(--texto-suave);
    font-size: 0.95rem;
  }

  .cal-demo {
    font-size: 0.85rem;
    color: var(--acento);
  }

  .cal-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }

  .cal-seleccion {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.8rem;
    min-width: 0;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }

  .cal-seleccion :global(strong) {
    color: var(--titulo);
    font-family: var(--fuente-ui);
  }

  .cal-borrar {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--borde);
    border-radius: 999px;
    background: transparent;
    color: var(--texto-suave);
    font: inherit;
    font-family: var(--fuente-ui);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  .cal-borrar[hidden] {
    display: none;
  }

  .cal-borrar:hover {
    background: var(--chip);
    color: var(--titulo);
  }

  .cal-demo a {
    color: var(--enlace);
    font-weight: 600;
  }

  .cal-flecha {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1.5px solid var(--borde);
    border-radius: 50%;
    background: transparent;
    color: var(--titulo);
    cursor: pointer;
  }

  .cal-flecha:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .cal-meses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem 2rem;
    margin-top: 0.4rem;
  }

  .cal-meses :global(h3) {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    text-align: center;
  }

  .cal-meses :global(.cal-grilla) {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.25rem;
  }

  .cal-meses :global(.cal-dia-nombre) {
    text-align: center;
    font-family: var(--fuente-ui);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--texto-suave);
    padding-bottom: 0.3rem;
  }

  .cal-meses :global(.cal-dia) {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--texto);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .cal-meses :global(.cal-dia:not(:disabled):hover) {
    background: var(--chip);
    transform: scale(1.06);
  }

  .cal-meses :global(.cal-dia.hoy) {
    box-shadow: inset 0 0 0 1.5px var(--acento);
  }

  .cal-meses :global(.cal-dia.pasado) {
    color: var(--texto-suave);
    opacity: 0.35;
    cursor: default;
