---
import HeroArt from './HeroArt.astro';
import { cabanas, clp, precioDesde } from '../data/cabanas';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const textos = {
  es: {
    kicker: 'Captren · Curacautín · La Araucanía',
    titulo: 'Cabañas Alto Captren',
    subtitulo: 'Descansa con vista al volcán, a 10 minutos del Parque Nacional Conguillío.',
    desde: 'Desde',
    noche: 'noche',
    reservar: 'Reservar',
    verCabanas: 'Ver cabañas',
    destacadosTitulo: 'Lo que vas a encontrar',
    destacados: [
      ['🌋', 'Vista al volcán', 'Despierta frente a la cordillera.'],
      ['🌲', 'Conguillío a 10 min', 'Araucarias, lagunas y senderos.'],
      ['💧', 'Salto Captren', 'A pocos minutos de las cabañas.'],
      ['🔥', 'Estufa a leña', 'Calor de verdad, también con nieve.'],
      ['📶', 'Wifi', 'Para conectarte cuando quieras.'],
      ['🐾', 'Se aceptan mascotas', 'Tu perro también está de vacaciones.'],
    ],
    cabanasTitulo: 'Nuestras cabañas',
    cabanasIntro:
      'Dos cabañas completas con cocina equipada, refrigerador, horno, agua caliente, parrilla, terraza, estacionamiento y ropa de cama.',
    personas: 'personas',
    dormitorios: 'dormitorios',
    bano: 'baño',
    porNoche: 'por noche',
    temporadaTitulo: 'Para todo el año',
    temporadaTexto:
      'Verano de lagos y senderos, o invierno con nieve. En temporada alta (diciembre a febrero, julio, agosto y fines de semana largos) la estadía mínima es de 2 noches.',
    reservaTitulo: 'Cómo reservar',
    pasos: [
      'Elige tu cabaña y tus fechas.',
      'Escríbenos por WhatsApp y te confirmamos disponibilidad y precio.',
      'Reserva con un abono del 50% por transferencia.',
    ],
    reservaPronto: 'El formulario de reserva y el calendario de disponibilidad estarán disponibles muy pronto.',
  },
  en: {
    kicker: 'Captren · Curacautín · Araucanía, Chile',
    titulo: 'Alto Captren Cabins',
    subtitulo: 'Relax with volcano views, 10 minutes from Conguillío National Park.',
    desde: 'From',
    noche: 'night',
    reservar: 'Book now',
    verCabanas: 'See the cabins',
    destacadosTitulo: 'What you will find',
    destacados: [
      ['🌋', 'Volcano views', 'Wake up facing the Andes.'],
      ['🌲', 'Conguillío, 10 min away', 'Monkey puzzle trees, lakes and trails.'],
      ['💧', 'Captren waterfall', 'Just a few minutes from the cabins.'],
      ['🔥', 'Wood stove', 'Real warmth, even when it snows.'],
      ['📶', 'Wifi', 'Stay connected whenever you want.'],
      ['🐾', 'Pet friendly', 'Your dog is on holiday too.'],
    ],
    cabanasTitulo: 'Our cabins',
    cabanasIntro:
      'Two private cabins with a fully equipped kitchen, fridge, oven, hot water, barbecue grill, deck, parking and bed linen.',
    personas: 'guests',
    dormitorios: 'bedrooms',
    bano: 'bathroom',
    porNoche: 'per night',
    temporadaTitulo: 'All year round',
    temporadaTexto:
      'Summer lakes and trails, or a snowy winter. In high season (December to February, July, August and long weekends) the minimum stay is 2 nights.',
    reservaTitulo: 'How to book',
    pasos: [
      'Choose your cabin and dates.',
      'Message us on WhatsApp and we will confirm availability and price.',
      'Secure your booking with a 50% deposit by bank transfer.',
    ],
    reservaPronto: 'The booking form and availability calendar are coming soon.',
  },
}[lang];
---

<section class="hero">
  <HeroArt />
  <div class="hero-shade"></div>
  <div class="container hero-content">
    <p class="kicker">{textos.kicker}</p>
    <h1>{textos.titulo}</h1>
    <p class="subtitulo">{textos.subtitulo}</p>
    <p class="desde">
      {textos.desde} <strong>{clp(precioDesde)}</strong> / {textos.noche}
    </p>
    <div class="acciones">
      <a class="btn" href="#reservar">{textos.reservar}</a>
      <a class="btn btn-outline" href="#cabanas">{textos.verCabanas}</a>
    </div>
  </div>
</section>

<section class="container seccion">
  <h2>{textos.destacadosTitulo}</h2>
  <ul class="destacados">
    {
      textos.destacados.map(([icono, titulo, texto]) => (
        <li>
          <span class="icono" aria-hidden="true">
            {icono}
          </span>
          <strong>{titulo}</strong>
          <span>{texto}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="container seccion" id="cabanas">
  <h2>{textos.cabanasTitulo}</h2>
  <p class="intro">{textos.cabanasIntro}</p>
  <div class="tarjetas">
    {
      cabanas.map((c) => (
        <article class="tarjeta">
          <div class="tarjeta-foto" aria-hidden="true">
            <span>{c.nombre[lang]}</span>
          </div>
          <div class="tarjeta-cuerpo">
            <h3>{c.nombre[lang]}</h3>
            <p class="datos">
              👥 {c.capacidad} {textos.personas} · 🛏️ {c.dormitorios} {textos.dormitorios} · 🚿 {c.banos} {textos.bano}
            </p>
            <ul class="camas">
              {c.camas[lang].map((cama) => (
                <li>{cama}</li>
              ))}
            </ul>
            <p class="precio">
              {textos.desde} <strong>{clp(c.precio.baja)}</strong> {textos.porNoche}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="container seccion temporada">
  <h2>{textos.temporadaTitulo}</h2>
  <p>{textos.temporadaTexto}</p>
</section>

<section class="container seccion" id="reservar">
  <h2>{textos.reservaTitulo}</h2>
  <ol class="pasos">
    {textos.pasos.map((paso) => <li>{paso}</li>)}
  </ol>
  <p class="aviso">{textos.reservaPronto}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 640px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(20 38 30 / 0.85) 0%, rgb(20 38 30 / 0.35) 45%, transparent 75%);
  }

  .hero-content {
    position: relative;
    padding: 6rem 0 3rem;
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(2.2rem, 7vw, 4rem);
    margin: 0.2rem 0 0.6rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .subtitulo {
    font-size: clamp(1.05rem, 2.8vw, 1.3rem);
    max-width: 36rem;
    margin: 0 0 1rem;
  }

  .desde {
    margin: 0 0 1.4rem;
  }

  .desde strong {
    font-size: 1.4rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .seccion {
    padding-top: 3.5rem;
  }

  .seccion h2 {
    font-size: clamp(1.6rem, 4.5vw, 2.2rem);
    margin: 0 0 1rem;
  }

  .intro {
    color: var(--texto-suave);
    max-width: 44rem;
  }

  .destacados {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }

  .destacados li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.1rem;
    background: #fff;
    border-radius: var(--radio);
    box-shadow: var(--sombra);
  }

  .destacados .icono {
    font-size: 1.8rem;
  }

  .destacados span:last-child {
    color: var(--texto-suave);
    font-size: 0.95rem;
  }

  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .tarjeta {
    background: #fff;
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    overflow: hidden;
  }

  .tarjeta-foto {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--bosque-claro), var(--madera));
    color: rgb(255 255 255 / 0.85);
    font-family: Georgia, serif;
    font-size: 1.6rem;
  }

  .tarjeta-cuerpo {
    padding: 1.2rem 1.3rem 1.4rem;
  }

  .tarjeta h3 {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
  }

  .datos {
    margin: 0 0 0.6rem;
    color: var(--texto-suave);
  }

  .camas {
    margin: 0 0 0.8rem;
    padding-left: 1.2rem;
  }

  .precio {
    margin: 0;
  }

  .precio strong {
    color: var(--madera);
    font-size: 1.25rem;
  }

  .temporada {
    max-width: 48rem;
  }

  .pasos {
    padding-left: 1.4rem;
  }

  .pasos li {
    margin-bottom: 0.5rem;
  }

  .aviso {
    padding: 0.9rem 1.1rem;
    background: var(--crema);
    border-left: 4px solid var(--madera);
    border-radius: 6px;
  }
</style>
