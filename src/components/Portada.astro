---
import { Picture } from 'astro:assets';
import fotoPortada from '../assets/portada-llaima.jpg';
import { cabanas, clp, precioDesde } from '../data/cabanas';
import type { Lang } from '../i18n/ui';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import CabanaDatos from './CabanaDatos.astro';
import { Image } from 'astro:assets';
import { fotosCabana, fotosLugares } from '../data/fotos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const textos = {
  es: {
    kicker: 'Captren · Curacautín · La Araucanía',
    fotoAlt: 'Volcán Llaima visto desde el camino a Captren, rodeado de bosque',
    titulo: 'Cabañas Alto Captren',
    subtitulo: 'Descansa con vista al volcán, a 10 minutos del Parque Nacional Conguillío.',
    desde: 'Desde',
    noche: 'noche',
    reservar: 'Reservar',
    verCabanas: 'Ver cabañas',
    destacadosTitulo: 'Lo que vas a encontrar',
    destacados: [
      ['mountain-snow', 'Vista al volcán', 'Despierta frente a la cordillera.'],
      ['trees', 'Conguillío a 10 min', 'Araucarias, lagunas y senderos.'],
      ['droplets', 'Salto Captren', 'A pocos minutos de las cabañas.'],
      ['flame', 'Estufa a leña', 'Calor de verdad, también con nieve.'],
      ['wifi', 'Wifi', 'Para conectarte cuando quieras.'],
      ['paw-print', 'Se aceptan mascotas', 'Tu perro también está de vacaciones.'],
    ],
    cabanasTitulo: 'Nuestras cabañas',
    cabanasIntro:
      'Dos cabañas completas con cocina equipada, refrigerador, horno, agua caliente, parrilla, terraza, estacionamiento y ropa de cama.',
    personas: 'personas',
    dormitorios: 'dormitorios',
    bano: 'baño',
    porNoche: 'por noche',
    verDetalle: 'Ver fotos, camas y precios',
    alrededoresTitulo: 'Alrededores',
    alrededoresIntro: 'Bosque nativo, cascadas y volcanes a minutos de tu cabaña.',
    lugares: [
      ['salto-captren', 'Salto Captren', 'A pocos minutos'],
      ['conguillio', 'Parque Nacional Conguillío', '10 min'],
      ['salto-princesa', 'Salto de la Princesa', 'Aprox. 45 min'],
    ],
    verActividades: 'Ver todo lo que puedes hacer',
    temporadaTitulo: 'Para todo el año',
    temporadaTexto:
      'Verano de lagos y senderos, o invierno con nieve. En temporada alta (diciembre a febrero, julio, agosto y fines de semana largos) la estadía mínima es de 2 noches.',
    reservaTitulo: 'Cómo reservar',
    pasos: [
      'Elige tu cabaña y tus fechas.',
      'Escríbenos por WhatsApp y te confirmamos disponibilidad y precio.',
      'Reserva con un abono del 50% por transferencia.',
    ],
    reservaPronto: 'Ir al formulario de reserva',
  },
  en: {
    kicker: 'Captren · Curacautín · Araucanía, Chile',
    fotoAlt: 'Llaima volcano seen from the road to Captren, surrounded by forest',
    titulo: 'Alto Captren Cabins',
    subtitulo: 'Relax with volcano views, 10 minutes from Conguillío National Park.',
    desde: 'From',
    noche: 'night',
    reservar: 'Book now',
    verCabanas: 'See the cabins',
    destacadosTitulo: 'What you will find',
    destacados: [
      ['mountain-snow', 'Volcano views', 'Wake up facing the Andes.'],
      ['trees', 'Conguillío, 10 min away', 'Monkey puzzle trees, lakes and trails.'],
      ['droplets', 'Captren waterfall', 'Just a few minutes from the cabins.'],
      ['flame', 'Wood stove', 'Real warmth, even when it snows.'],
      ['wifi', 'Wifi', 'Stay connected whenever you want.'],
      ['paw-print', 'Pet friendly', 'Your dog is on holiday too.'],
    ],
    cabanasTitulo: 'Our cabins',
    cabanasIntro:
      'Two private cabins with a fully equipped kitchen, fridge, oven, hot water, barbecue grill, deck, parking and bed linen.',
    personas: 'guests',
    dormitorios: 'bedrooms',
    bano: 'bathroom',
    porNoche: 'per night',
    verDetalle: 'See photos, beds and rates',
    alrededoresTitulo: 'Around the cabins',
    alrededoresIntro: 'Native forest, waterfalls and volcanoes just minutes from your cabin.',
    lugares: [
      ['salto-captren', 'Captren waterfall', 'A few minutes away'],
      ['conguillio', 'Conguillío National Park', '10 min'],
      ['salto-princesa', 'Salto de la Princesa', 'Approx. 45 min'],
    ],
    verActividades: 'See all things to do',
    temporadaTitulo: 'All year round',
    temporadaTexto:
      'Summer lakes and trails, or a snowy winter. In high season (December to February, July, August and long weekends) the minimum stay is 2 nights.',
    reservaTitulo: 'How to book',
    pasos: [
      'Choose your cabin and dates.',
      'Message us on WhatsApp and we will confirm availability and price.',
      'Secure your booking with a 50% deposit by bank transfer.',
    ],
    reservaPronto: 'Go to the booking form',
  },
}[lang];
---

<section class="hero">
  <Picture
    src={fotoPortada}
    alt={textos.fotoAlt}
    class="hero-foto"
    formats={['avif', 'webp']}
    widths={[640, 960, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-shade"></div>
  <div class="container hero-content">
    <p class="kicker">{textos.kicker}</p>
    <h1>{textos.titulo}</h1>
    <p class="subtitulo">{textos.subtitulo}</p>
    <p class="desde">
      {textos.desde} <strong>{clp(precioDesde)}</strong> / {textos.noche}
    </p>
    <div class="acciones">
      <a class="btn" href={url(`${lang}/reservar/`)}>{textos.reservar}</a>
      <a class="btn btn-outline" href="#cabanas">{textos.verCabanas}</a>
    </div>
  </div>
</section>

<section data-revelar class="container seccion">
  <h2>{textos.destacadosTitulo}</h2>
  <ul class="destacados" data-revelar-grupo>
    {
      textos.destacados.map(([icono, titulo, texto]) => (
        <li>
          <span class="icono-caja">
            <Icon name={icono} size={24} />
          </span>
          <strong>{titulo}</strong>
          <span>{texto}</span>
        </li>
      ))
    }
  </ul>
</section>

<section data-revelar class="container seccion" id="cabanas">
  <h2>{textos.cabanasTitulo}</h2>
  <p class="intro">{textos.cabanasIntro}</p>
  <div class="tarjetas" data-revelar-grupo>
    {
      cabanas.map((c) => (
        <article class="tarjeta">
          {fotosCabana[c.id]?.[0] && (
            <Image
              src={fotosCabana[c.id][0].src}
              alt={fotosCabana[c.id][0].alt[lang]}
              widths={[400, 640, 800]}
              sizes="(min-width: 700px) 520px, 100vw"
              class="tarjeta-foto"
            />
          )}
          <div class="tarjeta-cuerpo">
            <h3>{c.nombre[lang]}</h3>
            <CabanaDatos cabana={c} lang={lang} />
            <ul class="camas">
              {c.piezas.map((p) => (
                <li>{p[lang]}</li>
              ))}
            </ul>
            <p class="precio">
              {textos.desde} <strong>{clp(c.precio.baja)}</strong> {textos.porNoche}
            </p>
            <a class="ver-mas" href={url(`${lang}/cabanas/#${c.id}`)}>
              {textos.verDetalle} →
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section data-revelar class="container seccion">
  <h2>{textos.alrededoresTitulo}</h2>
  <p class="intro">{textos.alrededoresIntro}</p>
  <div class="lugares" data-revelar-grupo>
    {
      textos.lugares.map(([clave, nombre, distancia]) => (
        <a class="lugar" href={url(`${lang}/actividades/#${clave}`)}>
          <Image
            src={fotosLugares[clave].src}
            alt={fotosLugares[clave].alt[lang]}
            widths={[400, 720]}
            sizes="(min-width: 700px) 340px, 100vw"
            class="lugar-foto"
          />
          <span class="lugar-texto">
            <strong>{nombre}</strong>
            <span>{distancia}</span>
          </span>
        </a>
      ))
    }
  </div>
  <p><a class="ver-mas" href={url(`${lang}/actividades/`)}>{textos.verActividades} →</a></p>
</section>

<section class="container seccion temporada">
  <h2>{textos.temporadaTitulo}</h2>
  <p>{textos.temporadaTexto}</p>
</section>

<section data-revelar class="container seccion" id="reservar">
  <h2>{textos.reservaTitulo}</h2>
  <ol class="pasos">
    {textos.pasos.map((paso) => <li>{paso}</li>)}
  </ol>
  <p><a class="btn" href={url(`${lang}/reservar/`)}>{textos.reservaPronto} →</a></p>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 640px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .hero :global(.hero-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Enfoca el volcán y deja fuera la mayor parte del camino */
    object-position: 52% 38%;
    /* Acercamiento lento al cargar (efecto "Ken Burns") */
    animation: acercar 14s ease-out both;
  }

  @keyframes acercar {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  /* El texto de la portada entra de abajo hacia arriba, uno tras otro */
  .hero-content > * {
    animation: subir 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-content > :nth-child(2) {
    animation-delay: 0.12s;
  }

  .hero-content > :nth-child(3) {
    animation-delay: 0.24s;
  }

  .hero-content > :nth-child(4) {
    animation-delay: 0.36s;
  }

  .hero-content > :nth-child(5) {
    animation-delay: 0.48s;
  }

  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(15 30 24 / 0.9) 0%, rgb(15 30 24 / 0.45) 40%, rgb(15 30 24 / 0.05) 70%),
      linear-gradient(to right, rgb(15 30 24 / 0.45), transparent 60%);
  }

  .hero-content {
    position: relative;
    padding: 6rem 0 3rem;
  }

  /* Celular: foto arriba (que se vea el volcán) y texto debajo sobre verde bosque */
  @media (max-width: 700px) {
    .hero {
      display: block;
      min-height: auto;
      background: #0f1e18;
    }

    .hero :global(.hero-foto) {
      position: relative;
      height: 46vh;
      min-height: 260px;
      object-position: 52% 45%;
    }

    .hero-shade {
      bottom: auto;
      height: 46vh;
      min-height: 260px;
      background: linear-gradient(to top, #0f1e18 0%, rgb(15 30 24 / 0) 35%);
    }

    .hero-content {
      padding: 0.5rem 0 2.5rem;
    }
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(2.2rem, 7vw, 4rem);
    margin: 0.2rem 0 0.6rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .subtitulo {
    font-size: clamp(1.05rem, 2.8vw, 1.3rem);
    max-width: 36rem;
    margin: 0 0 1rem;
  }

  .desde {
    margin: 0 0 1.4rem;
  }

  .desde strong {
    font-size: 1.4rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .seccion {
    padding-top: 3.5rem;
  }

  .seccion h2 {
    font-size: clamp(1.6rem, 4.5vw, 2.2rem);
    margin: 0 0 1rem;
  }

  .intro {
    color: var(--texto-suave);
    max-width: 44rem;
  }

  .destacados {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }

  .destacados li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.1rem;
    background: #fff;
    border-radius: var(--radio);
    box-shadow: var(--sombra);
  }

  .icono-caja {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 0.5rem;
    border-radius: 12px;
    background: var(--crema);
    color: var(--bosque);
  }

  .destacados span:last-child {
    color: var(--texto-suave);
    font-size: 0.95rem;
  }

  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .tarjeta {
    background: #fff;
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    overflow: hidden;
  }

  .tarjeta :global(.tarjeta-foto) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
    object-fit: cover;
  }

  .lugares {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .lugar {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    color: #fff;
    text-decoration: none;
  }

  .lugar :global(.lugar-foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .lugar:hover :global(.lugar-foto) {
    transform: scale(1.04);
  }

  .lugar-texto {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    padding: 2.5rem 1rem 1rem;
    background: linear-gradient(to top, rgb(0 0 0 / 0.7), transparent);
  }

  .lugar-texto strong {
    font-family: var(--fuente-titulos);
    font-size: 1.3rem;
  }

  .lugar-texto span {
    font-size: 0.9rem;
    opacity: 0.9;
  }

  @media (max-width: 700px) {
    .lugar {
      aspect-ratio: 16 / 11;
    }
  }

  .tarjeta-cuerpo {
    padding: 1.2rem 1.3rem 1.4rem;
  }

  .tarjeta h3 {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
  }

  .datos {
    margin: 0 0 0.6rem;
    color: var(--texto-suave);
  }

  .camas {
    margin: 0 0 0.8rem;
    padding-left: 1.2rem;
  }

  .precio {
    margin: 0 0 0.6rem;
  }

  .ver-mas {
    font-weight: 600;
  }

  .precio strong {
    color: var(--madera);
    font-size: 1.25rem;
  }

  .temporada {
    max-width: 48rem;
  }

  .pasos {
    padding-left: 1.4rem;
  }

  .pasos li {
    margin-bottom: 0.5rem;
  }

  .aviso {
    padding: 0.9rem 1.1rem;
    background: var(--crema);
    border-left: 4px solid var(--madera);
    border-radius: 6px;
  }
</style>
