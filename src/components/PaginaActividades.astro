---
import type { Lang } from '../i18n/ui';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { fotosLugares } from '../data/fotos';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Temporada = 'todo' | 'verano' | 'invierno';

interface Actividad {
  icono: string;
  titulo: string;
  distancia: string;
  texto: string;
  temporada: Temporada;
  /** Clave de foto en src/data/fotos.ts */
  foto?: string;
  /** Video en /public/video (se muestra bajo la foto) */
  video?: string;
}

const textos = {
  es: {
    titulo: 'Qué hacer cerca',
    intro:
      'Desde las cabañas tienes a pocos minutos araucarias milenarias, lagunas, volcanes, saltos de agua, termas y nieve.',
    temporadas: { todo: 'Todo el año', verano: 'Mejor en verano', invierno: 'Invierno' },
    verVideo: 'Ver video',
    nota: 'Tiempos aproximados en auto desde las cabañas. Revisa horarios, tarifas y cierres del Parque Nacional Conguillío en el sitio de CONAF antes de ir.',
    actividades: [
      {
        icono: 'trees',
        titulo: 'Parque Nacional Conguillío',
        distancia: '10 min (entrada Captren)',
        texto:
          'Bosques de araucarias, el volcán Llaima, coladas de lava y lagos de agua turquesa. Uno de los parques más lindos de Chile.',
        temporada: 'todo',
        foto: 'conguillio',
      },
      {
        icono: 'droplets',
        titulo: 'Salto Captren',
        distancia: 'A pocos minutos',
        texto:
          'Una cascada ancha de agua turquesa en medio del bosque nativo, muy cerca de las cabañas. Con sol se forma un arcoíris.',
        temporada: 'todo',
        foto: 'salto-captren',
      },
      {
        icono: 'waves',
        titulo: 'Salto de la Princesa y Salto del Indio',
        distancia: 'Aprox. 45 min (unos 40 km)',
        texto:
          'El Salto de la Princesa cae entre paredes de roca a una poza de piedras. Está junto a la ruta 181, camino a Malalcahuello, igual que el Salto del Indio.',
        temporada: 'todo',
        foto: 'salto-princesa',
        video: 'video/salto-princesa.mp4',
      },
      {
        icono: 'footprints',
        titulo: 'Laguna Captren y sendero Los Carpinteros',
        distancia: 'Dentro del parque',
        texto: 'Sendero de unos 6 km entre araucarias milenarias que parte en la Laguna Captren.',
        temporada: 'verano',
      },
      {
        icono: 'bath',
        titulo: 'Termas de Manzanar y Malalcahuello',
        distancia: 'Aprox. 45 min a 1 h',
        texto: 'Piscinas termales para relajarse, especialmente ricas en invierno.',
        temporada: 'todo',
      },
      {
        icono: 'mountain-snow',
        titulo: 'Centro de ski Corralco',
        distancia: 'Aprox. 1 h',
        texto: 'Ski y snowboard en las faldas del volcán Lonquimay. En verano, trekking y paseos.',
        temporada: 'invierno',
      },
      {
        icono: 'tent-tree',
        titulo: 'Reserva Nacional Malalcahuello',
        distancia: 'Aprox. 1 h',
        texto: 'Senderos entre bosque nativo y arenales volcánicos.',
        temporada: 'verano',
      },
      {
        icono: 'snowflake',
        titulo: 'Nieve en las cabañas',
        distancia: 'Aquí mismo',
        texto: 'En invierno el sector se cubre de nieve: perfecto para jugar con niños y terminar el día junto a la estufa.',
        temporada: 'invierno',
      },
      {
        icono: 'store',
        titulo: 'Curacautín',
        distancia: 'Aprox. 30 min',
        texto: 'El pueblo más cercano: supermercado, restaurantes, farmacia y bencinera.',
        temporada: 'todo',
      },
    ] as Actividad[],
  },
  en: {
    titulo: 'Things to do nearby',
    intro:
      'Just minutes from the cabins you will find ancient monkey puzzle trees, lakes, volcanoes, waterfalls, hot springs and snow.',
    temporadas: { todo: 'All year', verano: 'Best in summer', invierno: 'Winter' },
    verVideo: 'Watch video',
    nota: 'Approximate driving times from the cabins. Check opening hours, fees and closures of Conguillío National Park on the CONAF website before you go.',
    actividades: [
      {
        icono: 'trees',
        titulo: 'Conguillío National Park',
        distancia: '10 min (Captren entrance)',
        texto:
          'Monkey puzzle tree forests, Llaima volcano, lava fields and turquoise lakes. One of the most beautiful parks in Chile.',
        temporada: 'todo',
        foto: 'conguillio',
      },
      {
        icono: 'droplets',
        titulo: 'Captren waterfall',
        distancia: 'A few minutes away',
        texto:
          'A wide turquoise waterfall in the middle of the native forest, very close to the cabins. On sunny days you will see a rainbow.',
        temporada: 'todo',
        foto: 'salto-captren',
      },
      {
        icono: 'waves',
        titulo: 'Salto de la Princesa and Salto del Indio',
        distancia: 'Approx. 45 min (about 40 km)',
        texto:
          'Salto de la Princesa falls between rock walls into a stony pool. It is right off route 181 towards Malalcahuello, like Salto del Indio.',
        temporada: 'todo',
        foto: 'salto-princesa',
        video: 'video/salto-princesa.mp4',
      },
      {
        icono: 'footprints',
        titulo: 'Captren Lake and Los Carpinteros trail',
        distancia: 'Inside the park',
        texto: 'A trail of about 6 km among ancient monkey puzzle trees, starting at Captren Lake.',
        temporada: 'verano',
      },
      {
        icono: 'bath',
        titulo: 'Manzanar and Malalcahuello hot springs',
        distancia: 'Approx. 45 min to 1 h',
        texto: 'Thermal pools to relax, especially lovely in winter.',
        temporada: 'todo',
      },
      {
        icono: 'mountain-snow',
        titulo: 'Corralco ski resort',
        distancia: 'Approx. 1 h',
        texto: 'Skiing and snowboarding on the slopes of Lonquimay volcano. Hiking in summer.',
        temporada: 'invierno',
      },
      {
        icono: 'tent-tree',
        titulo: 'Malalcahuello National Reserve',
        distancia: 'Approx. 1 h',
        texto: 'Trails through native forest and volcanic sand fields.',
        temporada: 'verano',
      },
      {
        icono: 'snowflake',
        titulo: 'Snow at the cabins',
        distancia: 'Right here',
        texto: 'In winter the area is covered in snow: perfect for kids, and for ending the day by the stove.',
        temporada: 'invierno',
      },
      {
        icono: 'store',
        titulo: 'Curacautín',
        distancia: 'Approx. 30 min',
        texto: 'The nearest town: supermarket, restaurants, pharmacy and petrol station.',
        temporada: 'todo',
      },
    ] as Actividad[],
  },
}[lang];
---

<section class="container pagina">
  <h1>{textos.titulo}</h1>
  <p class="intro">{textos.intro}</p>

  <ul class="actividades" data-revelar-grupo>
    {
      textos.actividades.map((a) => {
        const foto = a.foto ? fotosLugares[a.foto] : undefined;
        return (
        <li class:list={['actividad', { 'con-foto': foto }]} id={a.foto}>
          {foto && (
            <Image
              src={foto.src}
              alt={foto.alt[lang]}
              widths={[400, 720]}
              sizes="(min-width: 700px) 360px, 100vw"
              class="actividad-foto"
            />
          )}
          {!foto && (
            <span class="icono-caja">
              <Icon name={a.icono} size={26} />
            </span>
          )}
          <div class="actividad-cuerpo">
            <h2>{a.titulo}</h2>
            <p class="meta">
              <span class="distancia">
                <Icon name="map-pin" size={15} /> {a.distancia}
              </span>
              <span class={`etiqueta ${a.temporada}`}>{textos.temporadas[a.temporada]}</span>
            </p>
            <p>{a.texto}</p>
            {a.video && (
              <video
                class="actividad-video"
                src={url(a.video)}
                poster={url('video/salto-princesa-poster.jpg')}
                controls
                muted
                playsinline
                preload="none"
              >
                <a href={url(a.video)}>{textos.verVideo}</a>
              </video>
            )}
          </div>
        </li>
        );
      })
    }
  </ul>

  <p class="nota">{textos.nota}</p>
</section>

<style>
  .pagina {
    padding-top: 2.5rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.8rem);
    margin: 0 0 0.6rem;
  }

  .intro {
    color: var(--texto-suave);
    max-width: 46rem;
  }

  .actividades {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .actividad {
    display: flex;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem;
    background: #fff;
    border-radius: var(--radio);
    box-shadow: var(--sombra);
  }

  /* Actividades con foto: la foto arriba, el texto abajo */
  .actividad.con-foto {
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .con-foto .actividad-cuerpo {
    padding: 1rem 1.2rem 1.2rem;
  }

  .actividad :global(.actividad-foto) {
    width: 100%;
    height: 230px;
    object-fit: cover;
    display: block;
  }

  .actividad-video {
    display: block;
    width: 100%;
    max-height: 420px;
    margin-top: 0.9rem;
    border-radius: 10px;
    background: #000;
  }

  .icono-caja {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--crema);
    color: var(--bosque);
  }

  .distancia {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .actividad h2 {
    font-size: 1.2rem;
    margin: 0 0 0.3rem;
  }

  .actividad p {
    margin: 0.3rem 0 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: center;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .etiqueta {
    padding: 0.05rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .etiqueta.todo {
    background: var(--crema);
    color: var(--bosque);
  }

  .etiqueta.verano {
    background: #fbe8c8;
    color: #7a4a10;
  }

  .etiqueta.invierno {
    background: #dde9f0;
    color: #23506a;
  }

  .nota {
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
</style>
