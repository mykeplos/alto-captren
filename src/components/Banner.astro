---
// Encabezado con foto para las páginas internas (Cabañas, Ubicación, etc.).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  eyebrow?: string;
  intro?: string;
  imagen: ImageMetadata;
  alt: string;
  /** Qué parte de la foto mostrar, ej. "50% 40%". */
  posicion?: string;
}

const { titulo, eyebrow, intro, imagen, alt, posicion = '50% 50%' } = Astro.props;
---

<section class="banner">
  <Image
    src={imagen}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="banner-foto"
    style={`object-position:${posicion}`}
  />
  <div class="banner-sombra"></div>
  <div class="container banner-contenido">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{titulo}</h1>
    {intro && <p class="banner-intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(360px, 52vh);
    overflow: hidden;
    color: #fff;
    background: #0f1e18;
  }

  .banner :global(.banner-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: acercar-banner 12s ease-out both;
  }

  @keyframes acercar-banner {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  .banner-sombra {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(10 22 17 / 0.6) 0%, transparent 30%),
      linear-gradient(to top, rgb(10 22 17 / 0.88) 0%, rgb(10 22 17 / 0.3) 55%, transparent 80%);
  }

  .banner-contenido {
    position: relative;
    padding: 7rem 0 2.6rem;
  }

  .banner-contenido > * {
    animation: subir-banner 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .banner-contenido > :nth-child(2) {
    animation-delay: 0.1s;
  }

  .banner-contenido > :nth-child(3) {
    animation-delay: 0.2s;
  }

  @keyframes subir-banner {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .eyebrow {
    color: #e7b37e;
  }

  h1 {
    color: #fff;
    font-size: clamp(2.3rem, 6.5vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 0.8rem;
    max-width: 18ch;
  }

  .banner-intro {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: rgb(255 255 255 / 0.9);
  }
</style>
