---
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// TODO(#8): confirmar con el dueño el horario de entrada/salida, la política de cancelación, la leña y las toallas.
const textos = {
  es: {
    titulo: 'Preguntas frecuentes',
    otra: '¿Tienes otra pregunta? Escríbenos por WhatsApp y te respondemos.',
    preguntas: [
      ['¿Cómo reservo?', 'Escríbenos por WhatsApp con la cabaña, las fechas y cuántas personas son. Te confirmamos disponibilidad y precio, y la reserva queda lista con un abono del 50% por transferencia.'],
      ['¿Cuándo pago el resto?', 'El 50% restante se paga al llegar a la cabaña.'],
      ['¿A qué hora es la entrada y la salida?', 'La entrada es desde las 15:00 y la salida hasta las 12:00. Si necesitas otro horario, avísanos y vemos si se puede.'],
      ['¿Hay mínimo de noches?', 'En temporada alta (diciembre a febrero, julio, agosto y fines de semana largos) el mínimo es de 2 noches. El resto del año puedes quedarte una sola noche.'],
      ['¿Aceptan mascotas?', 'Sí, tus mascotas son bienvenidas. Solo avísanos al reservar.'],
      ['¿Qué incluyen las cabañas?', 'Cocina equipada, refrigerador, horno, estufa a leña, agua caliente, wifi, parrilla, terraza, estacionamiento y ropa de cama.'],
      ['¿Cómo se calefaccionan?', 'Con estufa a leña. Consúltanos por la leña al reservar.'],
      ['¿Hay wifi?', 'Sí, las cabañas tienen wifi.'],
      ['¿Se puede llegar en invierno con nieve?', 'Sí. Te recomendamos llevar cadenas y, si puedes, venir en 4×4. Escríbenos antes de salir y te contamos cómo está el camino.'],
      ['¿Qué pasa si tengo que cancelar?', 'Escríbenos lo antes posible. Te explicamos las condiciones de cancelación al momento de reservar.'],
      ['¿Dónde compro comida?', 'En Curacautín, a unos 30 minutos, hay supermercado, farmacia y bencinera. Te recomendamos comprar antes de subir.'],
    ],
  },
  en: {
    titulo: 'Frequently asked questions',
    otra: 'Any other question? Message us on WhatsApp and we will get back to you.',
    preguntas: [
      ['How do I book?', 'Message us on WhatsApp with the cabin, your dates and the number of guests. We will confirm availability and price, and your booking is secured with a 50% deposit by bank transfer.'],
      ['When do I pay the balance?', 'The remaining 50% is paid on arrival.'],
      ['What are check-in and check-out times?', 'Check-in is from 3:00 pm and check-out is by 12:00 noon. If you need a different time, let us know and we will try to help.'],
      ['Is there a minimum stay?', 'In high season (December to February, July, August and long weekends) the minimum stay is 2 nights. The rest of the year you can stay just one night.'],
      ['Are pets allowed?', 'Yes, pets are welcome. Just let us know when you book.'],
      ['What do the cabins include?', 'Fully equipped kitchen, fridge, oven, wood-burning stove, hot water, wifi, barbecue grill, deck, parking and bed linen.'],
      ['How are the cabins heated?', 'With a wood-burning stove. Ask us about firewood when you book.'],
      ['Is there wifi?', 'Yes, the cabins have wifi.'],
      ['Can I get there in winter when it snows?', 'Yes. We recommend bringing snow chains and, if possible, a 4×4. Message us before you leave and we will tell you about road conditions.'],
      ['What if I need to cancel?', 'Let us know as soon as possible. We will explain the cancellation terms when you book.'],
      ['Where can I buy food?', 'Curacautín, about 30 minutes away, has a supermarket, pharmacy and petrol station. We recommend shopping on your way up.'],
    ],
  },
}[lang];
---

<section class="container pagina">
  <h1>{textos.titulo}</h1>
  <div class="preguntas" data-revelar-grupo>
    {
      textos.preguntas.map(([pregunta, respuesta]) => (
        <details>
          <summary>{pregunta}</summary>
          <p>{respuesta}</p>
        </details>
      ))
    }
  </div>
  <p class="otra"><Icon name="message-circle" size={20} /> {textos.otra}</p>
</section>

<style>
  .pagina {
    padding-top: 2.5rem;
    max-width: 48rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.8rem);
    margin: 0 0 1.2rem;
  }

  .preguntas {
    display: grid;
    gap: 0.6rem;
  }

  details {
    background: #fff;
    border-radius: 10px;
    box-shadow: var(--sombra);
    padding: 0 1.1rem;
  }

  summary {
    cursor: pointer;
    padding: 0.9rem 0;
    font-weight: 700;
    color: var(--bosque);
    list-style-position: outside;
  }

  details[open] summary {
    border-bottom: 1px solid var(--crema);
  }

  details p {
    margin: 0.7rem 0 1rem;
  }

  .otra {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.6rem;
    font-weight: 600;
    color: var(--bosque);
  }
</style>
