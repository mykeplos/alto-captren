---
// Ilustración de relleno (volcán, bosque y cabaña) hasta tener las fotos reales.
---

<svg class="hero-art" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="cielo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9cc3d5" />
      <stop offset="1" stop-color="#e8eef0" />
    </linearGradient>
  </defs>
  <rect width="1200" height="600" fill="url(#cielo)" />
  <!-- volcán -->
  <path d="M250 470 L560 150 Q600 120 640 150 L960 470 Z" fill="#7d8b95" />
  <path d="M500 215 L560 150 Q600 120 640 150 L700 215 L660 200 L630 230 L600 205 L570 235 L540 205 Z" fill="#fbfcfd" />
  <!-- cerros -->
  <path d="M0 470 Q200 360 420 450 T820 430 T1200 420 V600 H0 Z" fill="#4c6f5b" />
  <path d="M0 520 Q300 440 600 510 T1200 490 V600 H0 Z" fill="#2f5643" />
  <!-- araucarias -->
  <g fill="#1f3a2e">
    <g transform="translate(140 400)">
      <rect x="-3" y="0" width="6" height="110" />
