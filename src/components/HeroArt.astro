    </g>
    <g transform="translate(940 430) scale(0.8)">
      <rect x="-3" y="0" width="6" height="110" />
      <path d="M-50 10 Q0 -10 50 10 Q0 0 -50 10 Z M-40 35 Q0 18 40 35 Q0 25 -40 35 Z M-30 58 Q0 44 30 58 Q0 50 -30 58 Z" />
    </g>
  </g>
  <!-- cabaña -->
  <g transform="translate(760 470)">
    <rect x="0" y="20" width="120" height="70" fill="#8a5a34" />
    <path d="M-15 25 L60 -30 L135 25 Z" fill="#5c3a20" />
    <rect x="48" y="50" width="24" height="40" fill="#3d2614" />
    <rect x="12" y="40" width="22" height="18" fill="#f3d27a" />
    <rect x="86" y="40" width="22" height="18" fill="#f3d27a" />
    <rect x="92" y="-18" width="12" height="28" fill="#5c3a20" />
