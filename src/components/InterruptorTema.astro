---
// Interruptor día / noche (tema claro y oscuro). Recuerda la elección en el navegador.
// Diseño segmentado: sol y luna en una píldora de vidrio, con un fondo que se desliza al activo.
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const etiqueta = lang === 'es' ? 'Modo noche' : 'Night mode';
---

<button class="interruptor" type="button" role="switch" aria-checked="false" aria-label={etiqueta} title={etiqueta}>
  <span class="indicador" aria-hidden="true"></span>
  <span class="opcion sol" aria-hidden="true"><Icon name="sun" size={16} /></span>
  <span class="opcion luna" aria-hidden="true"><Icon name="moon" size={15} /></span>
</button>

<script is:inline>
  (function () {
    var raiz = document.documentElement;
    var botones = document.querySelectorAll('.interruptor');
    var sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)');

    function pintar() {
      var noche = raiz.getAttribute('data-tema') === 'noche';
      botones.forEach(function (o) {
        o.setAttribute('aria-checked', String(noche));
      });
    }

    function aplicar(noche) {
      raiz.setAttribute('data-tema', noche ? 'noche' : 'dia');
      try {
        localStorage.setItem('tema', noche ? 'noche' : 'dia');
      } catch (e) {}
      pintar();
    }

    pintar();
    botones.forEach(function (b) {
      b.addEventListener('click', function () {
        var noche = raiz.getAttribute('data-tema') !== 'noche';

        // Navegadores modernos: el nuevo tema se abre en círculo desde el botón
        if (document.startViewTransition && !sinMovimiento.matches) {
          var r = b.getBoundingClientRect();
          var x = r.left + r.width / 2;
          var y = r.top + r.height / 2;
          var radio = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          raiz.classList.add('revelando-tema');
          var t = document.startViewTransition(function () {
            aplicar(noche);
          });
          t.ready.then(function () {
            raiz.animate(
              { clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + radio + 'px at ' + x + 'px ' + y + 'px)'] },
              { duration: 650, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' }
            );
          });
          t.finished.finally(function () {
            raiz.classList.remove('revelando-tema');
          });
          return;
        }

        // Los demás: cambio suave de colores
        raiz.classList.add('cambiando-tema');
        aplicar(noche);
        setTimeout(function () {
          raiz.classList.remove('cambiando-tema');
        }, 500);
      });
    });
  })();
</script>

<style is:global>
  /* Solo durante el cambio de tema: sin el fundido por defecto, para que se vea el círculo */
  html.revelando-tema::view-transition-old(root),
  html.revelando-tema::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<style>
  .interruptor {
    position: relative;
    flex: none;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 66px;
    height: 34px;
    padding: 3px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgb(247 245 240 / 0.7);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .interruptor:hover {
    background: rgb(255 255 255 / 0.18);
    border-color: rgb(255 255 255 / 0.45);
  }

  .interruptor:focus-visible {
    outline: 3px solid #e7b37e;
    outline-offset: 2px;
  }

  /* Fondo que se desliza bajo la opción activa */
  .indicador {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 28px;
    height: 26px;
    border-radius: 999px;
    background: #f7f5f0;
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.25),
      inset 0 -1px 0 rgb(0 0 0 / 0.06);
    transition:
      transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      background-color 0.35s ease;
  }

  [aria-checked='true'] .indicador {
    transform: translateX(30px);
    background: #1c2a24;
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.4),
      inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }

  .opcion {
    position: relative;
    display: grid;
    place-items: center;
    height: 26px;
    transition:
      color 0.3s ease,
      transform 0.35s ease;
  }

  /* Día: sol dorado sobre el fondo claro */
  [aria-checked='false'] .sol {
    color: #b8701c;
  }

  /* Noche: luna dorada sobre el fondo oscuro */
  [aria-checked='true'] .luna {
    color: #e7b37e;
  }

  [aria-checked='true'] .sol {
    transform: rotate(-90deg);
  }

  [aria-checked='false'] .luna {
    transform: rotate(-25deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .indicador,
    .opcion {
      transition: none;
    }
  }
</style>
