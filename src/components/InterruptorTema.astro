---
// Interruptor día / noche (tema claro y oscuro). Recuerda la elección en el navegador.
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const etiqueta = lang === 'es' ? 'Modo noche' : 'Night mode';
---

<button class="interruptor" type="button" role="switch" aria-checked="false" aria-label={etiqueta} title={etiqueta}>
  <span class="cielo" aria-hidden="true">
    <span class="estrella e1"></span>
    <span class="estrella e2"></span>
    <span class="estrella e3"></span>
    <span class="nube"></span>
  </span>
  <span class="perilla" aria-hidden="true">
    <span class="sol"><Icon name="sun" size={16} /></span>
    <span class="luna"><Icon name="moon" size={15} /></span>
  </span>
</button>

<script is:inline>
  (function () {
    var raiz = document.documentElement;
    document.querySelectorAll('.interruptor').forEach(function (b) {
      function pintar() {
        b.setAttribute('aria-checked', String(raiz.getAttribute('data-tema') === 'noche'));
      }
      pintar();
      b.addEventListener('click', function () {
        var noche = raiz.getAttribute('data-tema') !== 'noche';
        raiz.classList.add('cambiando-tema');
        raiz.setAttribute('data-tema', noche ? 'noche' : 'dia');
        try {
          localStorage.setItem('tema', noche ? 'noche' : 'dia');
        } catch (e) {}
        document.querySelectorAll('.interruptor').forEach(function (o) {
          o.setAttribute('aria-checked', String(noche));
        });
        setTimeout(function () {
          raiz.classList.remove('cambiando-tema');
        }, 500);
      });
    });
  })();
</script>

<style>
  .interruptor {
    position: relative;
    flex: none;
    width: 62px;
    height: 32px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    cursor: pointer;
    overflow: hidden;
    background: none;
  }

  .interruptor:focus-visible {
    outline: 3px solid #e7b37e;
    outline-offset: 2px;
  }

  /* Cielo: celeste de día, azul noche con estrellas */
  .cielo {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #8fd0f2, #4aa6dc);
    transition: background 0.5s ease;
  }

  [aria-checked='true'] .cielo {
    background: linear-gradient(135deg, #1b2450, #0b1030);
  }

  .estrella {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    transform: scale(0.3);
    transition:
      opacity 0.4s ease 0.15s,
      transform 0.4s ease 0.15s;
  }

  .e1 {
    top: 7px;
    left: 10px;
  }

  .e2 {
    top: 18px;
    left: 18px;
    width: 2px;
    height: 2px;
  }

  .e3 {
    top: 10px;
    left: 26px;
    width: 2px;
    height: 2px;
  }

  [aria-checked='true'] .estrella {
    opacity: 1;
    transform: scale(1);
  }

  .nube {
    position: absolute;
    right: 7px;
    bottom: 6px;
    width: 16px;
    height: 7px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.85);
    transition:
      opacity 0.3s ease,
      transform 0.4s ease;
  }

  [aria-checked='true'] .nube {
    opacity: 0;
    transform: translateY(8px);
  }

  /* Perilla: sol a la izquierda, luna a la derecha */
  .perilla {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #ffd56b;
    color: #b0620a;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
    transition:
      transform 0.45s cubic-bezier(0.5, 1.6, 0.4, 0.8),
      background 0.45s ease,
      color 0.45s ease;
  }

  [aria-checked='true'] .perilla {
    transform: translateX(30px) rotate(-30deg);
    background: #e9edf7;
    color: #3a4470;
  }

  .sol,
  .luna {
    grid-area: 1 / 1;
    display: grid;
    transition:
      opacity 0.3s ease,
      transform 0.45s ease;
  }

  .luna {
    opacity: 0;
    transform: scale(0.4);
  }

  [aria-checked='true'] .sol {
    opacity: 0;
    transform: scale(0.4) rotate(90deg);
  }

  [aria-checked='true'] .luna {
    opacity: 1;
    transform: none;
  }
</style>
