---
// Logo oficial: muestra la versión de día o de noche según el tema activo.
import { url } from '../lib/url';

interface Props {
  size: number;
  class?: string;
  /** Texto alternativo. Vacío si el nombre ya aparece al lado (decorativo). */
  alt?: string;
  loading?: 'eager' | 'lazy';
}

const { size, class: clase = '', alt = '', loading = 'lazy' } = Astro.props;
const archivo = size > 128 ? 512 : 256;
---

<span class:list={['logo', clase]} style={`--logo:${size}px`}>
  <img
    class="logo-dia"
    src={url(`logo/logo-dia-${archivo}.webp`)}
    alt={alt}
    width={size}
    height={size}
    loading={loading}
    decoding="async"
  />
  <img
    class="logo-noche"
    src={url(`logo/logo-noche-${archivo}.webp`)}
    alt={alt}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-block;
    flex: none;
    width: var(--logo);
    height: var(--logo);
  }

  .logo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .logo-noche {
    display: none !important;
  }

  :global(:root[data-tema='noche']) .logo-dia {
    display: none !important;
  }

  :global(:root[data-tema='noche']) .logo-noche {
    display: block !important;
  }
</style>
